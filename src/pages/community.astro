---
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import Arrow from '../components/Arrow.astro';
import { getImage } from 'astro:assets';
import { communitySchema } from '../lib/seo';
import { communityTitle, communityDescription } from '../lib/pages';
import { listedCommunityChannels, weekRunOrder } from '../data';
import mfisher10x from '../assets/guests/mfisher10x.jpg';
import captaincketh from '../assets/guests/captaincketh.jpg';
import thegreatola from '../assets/guests/thegreatola.jpg';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/about.css';
import '../styles/community.css';

const founders = await Promise.all([
  { name: 'Matthew Fisher', handle: 'mfisher10x', datetime: '2026-11-19', when: 'Thu 19 Nov', role: 'CEO of Katana. The first guest in the series.', image: mfisher10x },
  { name: 'CK', handle: 'CaptainCKeth', datetime: '2026-11-24', when: 'Tue 24 Nov', role: 'Co-founder of R3ACH.', image: captaincketh },
  { name: 'Ola', handle: 'thegreatola', datetime: '2026-11-26', when: 'Thu 26 Nov', role: 'AI engineer, building Vano.', image: thegreatola },
].map(async founder => ({
  ...founder,
  portrait: await getImage({ src: founder.image, width: 256, height: 256, format: 'webp', quality: 90 }),
})));

const title = communityTitle;
const description = communityDescription;
const schema = communitySchema(title, description, founders.map(founder => ({ name: founder.name, handle: founder.handle, role: founder.role, image: founder.portrait.src })));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15101d" />
    <Seo {title} {description} path="/community/" {schema} markdown="/community/index.md" />
  </head>
  <body class="about-page community-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <div class="about-opening">
      <Header active="community" />
      <main id="main">
        <section class="about-intro wrap" aria-labelledby="community-title">
          <div class="about-copy">
            <p class="eyebrow">COMMUNITY <span class="about-divider">/</span> JOIN CR2</p>
            <h1 id="community-title">Join the CR2 community.</h1>
            <p class="about-dek">Chill with R2 goes live on X every Tuesday and Thursday at 15:00 UTC. Between shows, the conversation continues on YouTube, Telegram and Discord. Here is how to watch, follow and take part.</p>
            <div class="sponsor-hero-actions">
              <a class="about-primary sponsor-cta" href="#join">How to join <Arrow direction="south" /></a>
              <a class="text-link" href="#founders">Meet the young founders <Arrow direction="south" /></a>
            </div>
          </div>
          <aside class="week-board" aria-label="The weekly CR2 schedule">
            <div class="week-board-heading"><span>THE WEEK</span><img src="/assets/studio-mark.svg" width="62" height="56" alt="" /></div>
            {weekRunOrder.map(day => (
              <div class="week-day-block">
                <div class="week-day-label"><span class="week-day">{day.day}</span><span class="week-day-note">Live on X</span></div>
                <ol class="week-slots">{day.slots.map(slot => (
                  <li class={'week-slot' + (slot.fixed ? ' is-fixed' : '')}><time>{slot.time}</time><span><strong>{slot.title}</strong><p>{slot.detail}</p></span></li>
                ))}</ol>
              </div>
            ))}
            <div class="week-board-footer"><span>CHILL WITH R2</span><span>ALL TIMES UTC</span></div>
          </aside>
        </section>
        <section class="formats-section" id="join" aria-labelledby="join-title">
          <div class="wrap">
            <div class="about-section-heading">
              <p class="eyebrow">HOW TO JOIN</p>
              <h2 id="join-title">Pick a way in.</h2>
              <p>Each channel has a job. Follow the show on X for the live episodes, then stay in the conversation between shows.</p>
            </div>
            <div class="format-grid join-grid">
              {listedCommunityChannels.map(channel => (
                <a class={'format-card ' + channel.accent} href={channel.url} target="_blank" rel="noopener noreferrer">
                  <p class="format-when">{channel.intent}</p>
                  <h3>{channel.name} <Arrow /></h3>
                  <p>{channel.note}</p>
                  <p class="format-meta">{channel.handle}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
        <section class="why-section wrap" id="schedule" aria-labelledby="schedule-title">
          <div class="about-section-heading">
            <p class="eyebrow">THE SCHEDULE</p>
            <h2 id="schedule-title">When CR2 is live.</h2>
            <p>The show goes live on X every Tuesday and Thursday at 15:00 UTC. Follow @chillwithr2 for the live link each show.</p>
          </div>
          <div class="why-grid">
            <article class="why-card"><span class="why-num">TUESDAY</span><h3>Market updates, guests and The Golden Ratio</h3><p>15:00 UTC market updates with ChillPill and R2D2, a top industry guest or Young Crypto Voices guest from 15:20, and The Golden Ratio with @that1618guy from 16:15.</p></article>
            <article class="why-card"><span class="why-num">THURSDAY</span><h3>Market updates, guests and In the Hood</h3><p>15:00 UTC market updates with ChillPill and R2D2, a top industry guest or Young Crypto Voices guest from 15:20, and In the Hood with Justin from 16:00.</p></article>
            <article class="why-card"><span class="why-num">EVERY EPISODE</span><h3>Replays and clips</h3><p>Each livestream stays up as a replay on X. Full episodes and key moments also go on the YouTube channel as they are published.</p></article>
          </div>
        </section>
        <section class="formats-section" id="founders" aria-labelledby="founders-title">
          <div class="wrap">
            <div class="about-section-heading">
              <p class="eyebrow">THE SERIES</p>
              <h2 id="founders-title">Young founders, builders and traders.</h2>
              <p class="founders-intro">A new series of conversations about the journey, what they are building, and the markets they work in. <a href="https://x.com/chillwithr2/status/2123049654568751240" target="_blank" rel="noopener noreferrer">Read the announcement on X <Arrow /></a></p>
            </div>
            <ol class="founders-list">
              {founders.map(founder => (
                <li>
                  <time datetime={founder.datetime} class="founders-when">{founder.when}</time>
                  <a class="founders-portrait" href={'https://x.com/' + founder.handle} target="_blank" rel="noopener noreferrer">
                    <img src={founder.portrait.src} width="256" height="256" loading="lazy" decoding="async" alt={founder.name + '’s X profile avatar'} />
                  </a>
                  <h3>{founder.name}</h3>
                  <p>{founder.role}</p>
                  <a class="guest-handle" href={'https://x.com/' + founder.handle} target="_blank" rel="noopener noreferrer">@{founder.handle}</a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      </main>
    </div>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p>Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh <Arrow /></a><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top"><Arrow direction="north" /></a></footer>
  </body>
</html>

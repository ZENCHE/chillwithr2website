---
import Header from '../../../components/Header.astro';
import Seo from '../../../components/Seo.astro';
import Arrow from '../../../components/Arrow.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { episodePages, relatedEpisodes, episodeHref, type EpisodePage } from '../../../lib/episode-pages';
import { episodeSchema } from '../../../lib/seo';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../../../styles/global.css';
import '../../../styles/about.css';
import '../../../styles/episode.css';

export function getStaticPaths(){return episodePages.map(page=>({params:{slug:page.path.split('/')[2]},props:{page}}));}
interface Props { page: EpisodePage }
const { page } = Astro.props;
const e = page.episode;
const photos = import.meta.glob<ImageMetadata>('../../../assets/guests/*.jpg',{eager:true,import:'default'});
const hostPhotos: Record<string,string> = { ripchillpill: '/assets/chill-pill-avatar.png', r2d2zen: '/assets/r2d2-avatar.png' };
const people = await Promise.all(page.guests.map(async g => {
  const src = photos[`../../../assets/guests/${g.handle.toLowerCase()}.jpg`];
  return { ...g, photo: src ? (await getImage({ src, width: 256, height: 256, format: 'webp', quality: 90 })).src : hostPhotos[g.handle.toLowerCase()] };
}));
const related = relatedEpisodes(page.number);
const schema = episodeSchema(page);
const dateLabel = e.date;
const yt = page.youtubeId;
const videoTitle = `Episode ${page.number}: ${e.title} on YouTube`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15101d" />
    <Seo title={page.title} description={page.description} path={page.path} {schema} markdown={page.path + 'index.md'} />
  </head>
  <body class="about-page episode-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <div class="about-opening">
      <Header active="none" />
      <main id="main">
        <article class={'episode-article ' + e.accent}>
          <section class={'about-intro episode-intro wrap' + (yt ? ' has-video' : '')} aria-labelledby="ep-title">
            <div class="about-copy">
              <nav class="episode-crumbs" aria-label="Breadcrumb"><a href="/">CR2</a><span aria-hidden="true">/</span><a href="/#episodes">Episodes</a><span aria-hidden="true">/</span><span aria-current="page">Ep {page.number}</span></nav>
              <p class="eyebrow">EPISODE {page.number} <span class="about-divider">/</span> <time datetime={e.dateTime}>{dateLabel}</time></p>
              <h1 id="ep-title">{e.title}</h1>
              <p class="about-dek">{page.summary}</p>
              {yt && (
                <div class="episode-video">
                  <button type="button" class="yt-facade" data-yt={yt} data-title={videoTitle} aria-label={`Play ${videoTitle}`}>
                    <img src={`https://i.ytimg.com/vi/${yt}/maxresdefault.jpg`} onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${yt}/hqdefault.jpg'`} alt={`Video thumbnail for Episode ${page.number}: ${e.title}`} width="1280" height="720" loading="lazy" decoding="async" />
                    <span class="yt-play" aria-hidden="true"><svg viewBox="0 0 68 48" width="68" height="48"><path class="yt-play-bg" d="M66.5 7.7A8.6 8.6 0 0 0 60.5 1.6C55.2.2 34 .2 34 .2s-21.2 0-26.5 1.4A8.6 8.6 0 0 0 1.5 7.7C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6.1C12.8 47.8 34 47.8 34 47.8s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6.1C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"/><path d="M45 24 27 14v20Z" fill="#fff"/></svg></span>
                  </button>
                  <noscript><a class="yt-noscript" href={`https://www.youtube.com/watch?v=${yt}`} target="_blank" rel="noopener noreferrer">Watch on YouTube <Arrow /></a></noscript>
                </div>
              )}
              <div class="sponsor-hero-actions">
                <a class={yt ? 'text-link' : 'about-primary'} href={e.url} target="_blank" rel="noopener noreferrer">Watch the replay on X <Arrow /></a>
                <a class="text-link" href="#chapters">Jump to the chapters <Arrow direction="south" /></a>
              </div>
              <ul class="episode-topics" aria-label="Topics">{page.topics.map(t => <li>{t}</li>)}</ul>
            </div>
          </section>
          <section class="why-section wrap" aria-labelledby="takeaways-title">
            <div class="about-section-heading"><p class="eyebrow">KEY TAKEAWAYS</p><h2 id="takeaways-title">{page.takeaways.length === 4 ? "Four" : "Five"} things<br />from the show.</h2></div>
            <ol class="why-grid takeaways">{page.takeaways.map((t, i) => <li class="why-card"><span class="why-num">{String(i + 1).padStart(2, '0')}</span><p>{t}</p></li>)}</ol>
          </section>
          <section class="wrap episode-block" id="chapters" aria-labelledby="chapters-title">
            <div class="about-section-heading"><p class="eyebrow">CHAPTERS</p><h2 id="chapters-title">Jump in.</h2><p>Times are from the start of the X replay.</p></div>
            <ol class="chapter-list">{page.chapters.map(c => <li class="program-row"><span class="chapter-time">{c.label}</span><span class="program-name">{c.title}</span></li>)}</ol>
          </section>
          {people.length > 0 && (
            <section class="guest-section" aria-labelledby="ep-guests-title">
              <div class="wrap">
                <div class="guest-heading"><div><p class="eyebrow">ON THIS EPISODE</p><h2 id="ep-guests-title">Guests.</h2></div></div>
                <div class="guest-grid">{people.map(g => (
                  <a class="guest" aria-label={g.name + ' on X'} href={g.url} target="_blank" rel="noopener noreferrer">
                    <span class="guest-portrait">{g.photo && <img src={g.photo} width="256" height="256" loading="lazy" decoding="async" alt={g.name + '’s X profile avatar'} />}</span>
                    <span class="guest-content"><span class="guest-name">{g.name}<Arrow /></span>{g.role && <span class="guest-role">{g.role}</span>}<span class="guest-handle">@{g.handle}</span></span>
                  </a>
                ))}</div>
              </div>
            </section>
          )}
          <section class="wrap episode-block community" aria-label="Community">
            <p class="community-line">{page.communityLine}</p>
            {page.communityUrl && <a class="about-primary community-cta" href={page.communityUrl} target="_blank" rel="noopener noreferrer">{page.communityCta ?? "Join the community"} <Arrow /></a>}
            <div class="newsletter-slot" aria-label="Newsletter"><p class="format-when">NEWSLETTER</p><p>Coming soon. Until then, follow <a href="https://x.com/chillwithr2" target="_blank" rel="noopener noreferrer">@chillwithr2</a> for every show.</p></div>
          </section>
          <section class="wrap episode-block" aria-labelledby="related-title">
            <div class="about-section-heading"><p class="eyebrow">KEEP WATCHING</p><h2 id="related-title">Related episodes.</h2></div>
            <ol class="related-list">{related.map(r => { const href = episodeHref(r); return (
              <li class={'program-row ' + r.accent}><a href={href ?? r.url} {...(href ? {} : { target: '_blank', rel: 'noopener noreferrer' })}><span class="program-num">EP {r.number}</span><time datetime={r.dateTime}>{r.date}</time><span class="program-name">{r.title}</span><span class="program-guests">{r.guests}</span><Arrow class="program-arrow" direction={href ? 'east' : 'ne'} /></a></li>
            ); })}</ol>
          </section>
        </article>
      </main>
    </div>
    {yt && <script is:inline>document.querySelectorAll('.yt-facade').forEach(b=>b.addEventListener('click',()=>{const f=document.createElement('iframe');f.src='https://www.youtube-nocookie.com/embed/'+b.dataset.yt+'?autoplay=1&rel=0';f.title=b.dataset.title;f.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';f.allowFullscreen=true;f.referrerPolicy='strict-origin-when-cross-origin';b.replaceWith(f);f.focus();},{once:true}));</script>}
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top"><Arrow direction="north" /></a></footer>
  </body>
</html>

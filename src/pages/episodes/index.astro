---
import { episodes } from '../../data';
import Header from '../../components/Header.astro';
import Seo from '../../components/Seo.astro';
import Arrow from '../../components/Arrow.astro';
import { episodesSchema } from '../../lib/seo';
import { episodesTitle, episodesDescription } from '../../lib/pages';
import { episodeHref, replayLink } from '../../lib/episode-pages';
import { YOUTUBE_SUBSCRIBE } from '../../site-config';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../../styles/global.css';
import '../../styles/about.css';
import '../../styles/episode.css';

const title = episodesTitle;
const description = episodesDescription;
const schema = episodesSchema(title, description);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15101d" />
    <Seo {title} {description} path="/episodes/" {schema} markdown="/episodes/index.md" />
  </head>
  <body class="about-page episodes-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <div class="about-opening">
      <Header active="episodes" />
      <main id="main">
        <section class="about-intro wrap" aria-labelledby="episodes-title">
          <div class="about-copy">
            <nav class="episode-crumbs" aria-label="Breadcrumb"><a href="/">CR2</a><span aria-hidden="true">/</span><span aria-current="page">Episodes</span></nav>
            <p class="eyebrow">THE PROGRAM <span class="about-divider">/</span> EVERY EPISODE</p>
            <h1 id="episodes-title">Every episode<span>.</span></h1>
            <p class="about-dek">Newest first. Open an episode for show notes, or watch the replay on YouTube when the video is public, otherwise on X. The show is live Tuesday and Thursday at 15:00 UTC.</p>
            <a class="text-link" href={YOUTUBE_SUBSCRIBE} target="_blank" rel="noopener noreferrer">Subscribe on YouTube <Arrow /></a>
          </div>
        </section>
        <section class="wrap episodes-archive" aria-labelledby="program-title">
          <div class="program-list">
            <h2 id="program-title" class="program-title">The archive<span>.</span></h2>
            <ol aria-labelledby="program-title">
              {episodes.map((episode) => { const href = episodeHref(episode); const replay = replayLink(episode); return (
                <li class={'program-row ' + episode.accent}>
                  <a href={href ?? episode.url} {...(href ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
                    <span class="program-num">EP {episode.number}</span>
                    <time datetime={episode.dateTime}>{episode.date}</time>
                    <span class="program-name">{episode.title}</span>
                    <span class="program-guests">{episode.guests}</span>
                    <Arrow class="program-arrow" direction={href ? 'east' : 'ne'} />
                  </a>
                  {href && <a class="program-replay" href={replay.url} target="_blank" rel="noopener noreferrer">{replay.label} <Arrow /></a>}
                </li>
              ); })}
            </ol>
          </div>
        </section>
      </main>
    </div>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p><a href={YOUTUBE_SUBSCRIBE} target="_blank" rel="noopener noreferrer">Subscribe on YouTube <Arrow /></a><span class="footer-powered">Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh <Arrow /></a></span><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top"><Arrow direction="north" /></a></footer>
  </body>
</html>

---
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import chillAvatar from '../../public/assets/chill-pill-avatar.png';
import r2Avatar from '../../public/assets/r2d2-avatar.png';
import { episodes, hosts } from '../data';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/about.css';

const canonical = 'https://chill-with-r2.daring-pine-5405.chatgpt.site/about/';
const title = 'About CR2 — Meet your next audience';
const description = 'Meet the founders, investors and technologists watching CR2. Explore the audience, communities and guests behind Chill with R2.';
const guestAvatars = import.meta.glob<ImageMetadata>('../assets/guests/*.jpg', { eager: true, import: 'default' });
const guests = [
  { name: 'Justin Bebis', handle: 'justinbebis', role: 'Co-founder, Mosh · CEO, UV' },
  { name: 'Tom Wan', handle: 'tomwanhh', role: 'Head of Data, Entropy Advisors · ex-21Shares' },
  { name: 'Zack Brenner', handle: 'zjbrenner', role: 'Product Marketing, OpenSea · ex-Rally' },
  { name: 'SimpleFarmer', handle: 'OxSimpleFarmer', role: 'Founder, Clutch Markets · StonkBrokers' },
  { name: 'DataLust', handle: 'DataLust_xyz', role: 'Builds Zona · Open House buildathon winner¹' },
  { name: 'that1618guy', handle: 'that1618guy', role: 'Founder, Stateofblocks · ex-Delphi Digital' },
  { name: 'banditxbt', handle: 'banditxbt', role: 'VP, PonderCorp · Robinhood Chain data' },
  { name: 'Berdyn', handle: 'berdyn', role: 'Founder, PonderCorp · daily Robinhood Spaces' },
  { name: 'Nill', handle: 'BigNillCollect', role: 'Blockworks · ex-Polygon & Magic Eden' },
  { name: 'Eliza', handle: 'Elizacreatez', role: '88.5k X followers²' },
  { name: 'Srini', handle: 'srinigoes', role: 'Token2049 special · live from Singapore' },
  { name: 'Average Joes Crypto', handle: 'AvgJoesCrypto', role: '33k X followers²' }
];
const communities = [
  { name: 'Mosh Pit', count: '5,000+', label: 'members' },
  { name: 'GreenFeed', count: '800+', label: 'subscribers' },
  { name: 'Gypsy Traders', count: '440+', label: 'subscribers' },
  { name: 'MHH Colony', count: 'Private', label: 'investor group' }
];
const schema = { '@context': 'https://schema.org', '@type': 'AboutPage', url: canonical, name: title, description, about: { '@type': 'Organization', name: 'CR2', url: 'https://chill-with-r2.daring-pine-5405.chatgpt.site/' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15101d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/cr2-mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://chill-with-r2.daring-pine-5405.chatgpt.site/assets/cr2-studio-social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://chill-with-r2.daring-pine-5405.chatgpt.site/assets/cr2-studio-social.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body class="about-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <div class="about-opening">
      <Header active="about" />
      <main id="main">
        <section class="about-intro wrap" aria-labelledby="about-title">
          <div class="about-copy">
            <p class="eyebrow">ABOUT CR2 <span class="about-divider">/</span> FOR ADVERTISERS</p>
            <h1 id="about-title">Meet your<br />next <em>audience.</em></h1>
            <p class="about-dek">CR2 is independent media for crypto, finance and tech. Our flagship podcast, <strong>Chill with R2</strong>, covers Robinhood Chain with the people building on it.</p>
            <a class="about-primary" href="#audience">Get to know the audience <span aria-hidden="true">↓</span></a>
          </div>
          <aside class="host-board" aria-label="The hosts and their reach on X">
            <div class="host-board-heading"><span>THE HOSTS</span><img src="/assets/studio-mark.svg" width="62" height="56" alt="" /></div>
            {hosts.map((host, index) => (
              <a class={'reach-host ' + (index === 0 ? 'chill' : 'r2')} href={host.url} target="_blank" rel="noopener noreferrer">
                <Image class="reach-avatar" src={index === 0 ? chillAvatar : r2Avatar} width={200} height={200} format="webp" quality={90} alt="" loading="eager" decoding="async" />
                <span class="reach-person"><strong>{host.name}</strong><small>{host.handle}</small><span class="reach-followers">{index === 0 ? '≈100k' : '≈14.6k'}<small>X followers²</small></span></span>
                <span class="reach-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
            <div class="host-board-footer"><span>CHILL WITH R2</span><span>ON X</span></div>
          </aside>
        </section>
        <section class="reach-strip" aria-label="CR2 reach figures">
          <div class="wrap reach-strip-inner">
            <div class="reach-stat"><strong>150k<span>+</span></strong><p>Views on CR2-related X posts<small>Across the show and both hosts · October snapshot</small></p></div>
            <div class="reach-stat"><strong>757<span>+</span></strong><p>Viewer hours per month<small>Reported monthly viewing time</small></p></div>
          </div>
        </section>
        <section class="audience-section wrap" id="audience" aria-labelledby="audience-title">
          <div class="about-section-heading"><p class="eyebrow">WHO TUNES IN</p><h2 id="audience-title">People who build.<br />People who invest.</h2><p>Founders, high-net-worth investors, technologists and finance professionals. A focused audience for brands working in crypto, finance and tech.</p></div>
          <div class="audience-grid">
            <div class="geography">
              <h3>A global audience.</h3>
              <p>The US and UK lead, with viewers across developed and emerging markets.</p>
              <div class="geo-strip" aria-hidden="true"><span></span><span></span><span></span></div>
              <dl class="geo-key"><div><dt><i aria-hidden="true"></i>United States</dt><dd>28%</dd></div><div><dt><i aria-hidden="true"></i>United Kingdom</dt><dd>8%</dd></div><div><dt><i aria-hidden="true"></i>Rest of the world</dt><dd>64%</dd></div></dl>
            </div>
            <div class="distribution">
              <div class="distribution-heading"><h3>Beyond the broadcast.</h3><span><b>6,000+</b> community memberships</span></div>
              <p>Every show and clip is shared across CR2’s communities.</p>
              <dl class="community-list">{communities.map(community => <div><dt>{community.name}</dt><dd>{community.count}<small>{community.label}</small></dd></div>)}</dl>
              <p class="about-note">Combined published sizes of the first three communities; memberships may overlap. MHH Colony is additional.</p>
            </div>
          </div>
        </section>
        <section class="guest-section" id="guests" aria-labelledby="guests-title">
          <div class="wrap">
            <div class="guest-heading"><div><p class="eyebrow">THE CONVERSATIONS</p><h2 id="guests-title">Who’s been on CR2.</h2></div><a class="text-link" href="/#episodes">Watch the show <span aria-hidden="true">↗</span></a></div>
            <div class="guest-grid">{guests.map(guest => (
              <a class="guest" href={'https://x.com/' + guest.handle} target="_blank" rel="noopener noreferrer">
                <span class="guest-portrait"><Image src={guestAvatars['../assets/guests/' + guest.handle.toLowerCase() + '.jpg']} width={256} height={256} format="webp" quality={90} loading="lazy" decoding="async" alt="" /></span>
                <span class="guest-content"><span class="guest-name">{guest.name}<span aria-hidden="true">↗</span></span><span class="guest-role">{guest.role}</span><span class="guest-handle">@{guest.handle}</span></span>
              </a>
            ))}</div>
            <p class="about-note guest-note">¹ Zona won the Open Category at the Arbitrum × Robinhood Chain Open House buildathon, which drew 1,200+ builders.</p>
          </div>
        </section>
        <section class="about-close wrap" aria-labelledby="close-title">
          <div><p class="eyebrow">SEE IT FOR YOURSELF</p><h2 id="close-title">Get to know CR2.</h2></div>
          <a class="about-primary" href={episodes[0].url} target="_blank" rel="noopener noreferrer">Watch the latest episode <span aria-hidden="true">↗</span></a>
        </section>
        <div class="wrap metrics-notes">
          <details>
            <summary>About the numbers <span aria-hidden="true">+</span></summary>
            <div><p>Figures and audience profile supplied by CR2. Post views cover October 2026 posts about CR2 from @chillwithr2, @R2D2zen and @ripchillpill, using public X metrics as of 22 October. They are cumulative views, not unique viewers. Monthly viewer hours are reported by CR2.</p><p>² Follower figures are approximate October 2026 snapshots supplied by CR2, not live counts. Guest roles reflect the supplied guest list. Community sizes are reported memberships and subscriptions, not deduplicated people.</p><p>Examples from the 22 October snapshot: launch post, 10,100 views; Episode 3 with @that1618guy, 8,258; Episode 3 clip, 8,167.</p></div>
          </details>
        </div>
      </main>
    </div>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p>Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh ↗</a><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top">↑</a></footer>
  </body>
</html>

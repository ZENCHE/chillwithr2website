---
import { episodes, hosts } from '../data';
import '@fontsource-variable/fredoka';
import '../styles/global.css';

const featured = episodes[0];
const previous = episodes.slice(1);
const canonical = 'https://chill-with-r2.daring-pine-5405.chatgpt.site/';
const title = 'CR2 — Crypto, finance & tech';
const description = 'Independent media on crypto, finance, and tech. Home of Chill with R2, a live podcast covering Robinhood Chain.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': canonical + '#company', name: 'CR2', url: canonical, description, sameAs: ['https://x.com/chillwithr2'] },
    { '@type': 'PodcastSeries', name: 'Chill with R2', url: canonical + '#show', description: 'A live podcast covering Robinhood Chain.', publisher: { '@id': canonical + '#company' }, sameAs: ['https://x.com/chillwithr2'] }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#21172f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/cr2-mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonical + 'assets/cr2-social.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonical + 'assets/cr2-social.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <header class="header wrap">
      <a class="brand" href="#top" aria-label="CR2 home"><img src="/assets/cr2-mark-dark.svg" width="62" height="56" alt="CR2" /></a>
      <nav aria-label="Primary navigation"><a href="#episodes">Episodes</a><a href="#hosts">Hosts</a></nav>
      <a class="follow" href="https://x.com/chillwithr2" target="_blank" rel="noopener noreferrer">Follow on X <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
      <section class="intro wrap" aria-labelledby="intro-title">
        <div class="intro-copy">
          <p class="eyebrow"><span></span> INDEPENDENT MEDIA COMPANY</p>
          <h1 id="intro-title">Crypto.<br />Finance.<br /><span>Tech.</span></h1>
          <p class="intro-dek">Home of <strong>Chill with R2</strong>, a live podcast covering Robinhood Chain.</p>
          <a class="button" href={featured.url} target="_blank" rel="noopener noreferrer">Watch latest episode <span aria-hidden="true">↗</span></a>
        </div>
        <div class="show" id="show">
          <div class="studio">
            <div class="studio-top"><span>FLAGSHIP PODCAST</span><button id="intro-audio" type="button" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8h3l4-4v12l-4-4H3zM13 7a5 5 0 0 1 0 6M16 4a9 9 0 0 1 0 12" /></svg><span>Play intro</span></button></div>
            <img class="neon" src="/assets/cr2-neon.svg" alt="Chill with R2" width="880" height="680" fetchpriority="high" />
          </div>
          <a class="featured" href={featured.url} target="_blank" rel="noopener noreferrer">
            <span class="featured-meta">LATEST · EP {featured.number}<time datetime={featured.dateTime}>{featured.date}</time></span>
            <span class="featured-title">{featured.title}<span class="play" aria-hidden="true">↗</span></span>
            <span class="featured-guests">{featured.guests}</span>
          </a>
          <audio id="bumper" src="/assets/cr2-bumper.wav" preload="none"></audio>
        </div>
      </section>
      <div class="schedule wrap"><span class="schedule-label">CHILL WITH R2</span><span>Live on X <b>Tue + Thu · 15:00 UTC</b></span><span class="partner">Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh ↗</a></span></div>
      <section class="archive" id="episodes" aria-labelledby="episodes-title">
        <div class="wrap">
          <div class="archive-heading"><h2 id="episodes-title">Recent episodes</h2><a href="https://x.com/chillwithr2" target="_blank" rel="noopener noreferrer">All episodes <span aria-hidden="true">↗</span></a></div>
          <div class="episode-list">
            {previous.map((episode) => (
              <a class="episode" href={episode.url} target="_blank" rel="noopener noreferrer">
                <span class={'episode-number ' + episode.accent}>/{episode.number}</span>
                <span class="episode-copy"><h3>{episode.title}</h3><span>{episode.guests}</span></span>
                <span class="episode-date">{episode.date}</span>
                <span class="episode-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="hosts wrap" id="hosts" aria-labelledby="hosts-title">
        <h2 id="hosts-title">Your hosts</h2>
        <div class="host-list">
          {hosts.map((host) => (
            <a class="host" href={host.url} target="_blank" rel="noopener noreferrer"><span class="host-initial" aria-hidden="true">{host.initials}</span><span><strong>{host.name}</strong><small>{host.handle}</small></span><span class="host-arrow" aria-hidden="true">↗</span></a>
          ))}
        </div>
      </section>
    </main>
    <footer class="footer wrap"><span>© 2026 CR2</span><p>CR2 is not affiliated with Robinhood Markets, Inc.</p><a href="#top">Back to top ↑</a></footer>
    <script>import '../scripts/site';</script>
  </body>
</html>


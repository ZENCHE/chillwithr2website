---
import { episodes, hosts } from '../data';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

const featured = episodes[0];
const canonical = 'https://chill-with-r2.daring-pine-5405.chatgpt.site/';
const title = 'CR2 — Crypto, finance & tech';
const description = 'Independent media on crypto, finance, and tech. Home of Chill with R2, a live podcast covering Robinhood Chain.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': canonical + '#company', name: 'CR2', url: canonical, description, sameAs: ['https://x.com/chillwithr2'] },
    { '@type': 'PodcastSeries', name: 'Chill with R2', url: canonical + '#show', description: 'A live podcast covering Robinhood Chain.', publisher: { '@id': canonical + '#company' }, sameAs: ['https://x.com/chillwithr2'] }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#21172f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/cr2-mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonical + 'assets/cr2-studio-social.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonical + 'assets/cr2-studio-social.png'} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <main id="main">
      <section class="hero" aria-labelledby="intro-title" id="studio">
        <div class="scene" aria-hidden="true">
          <div class="wall"></div><div class="wall-shade"></div>
          <div class="light light-violet"></div><div class="light light-green"></div><div class="light light-pink"></div>
          <div class="scene-grain"></div>
        </div>
        <header class="header wrap">
          <a class="brand" href="#top" aria-label="CR2 home"><img src="/assets/studio-mark.svg" width="62" height="56" alt="CR2" /><span>INDEPENDENT<br />MEDIA</span></a>
          <nav aria-label="Primary navigation"><a href="#episodes">Episodes</a><a href="#hosts">Hosts</a></nav>
          <a class="follow" href="https://x.com/chillwithr2" target="_blank" rel="noopener noreferrer">Follow on X <span aria-hidden="true">↗</span></a>
        </header>
        <div class="hero-content wrap">
          <div class="intro-copy">
            <p class="eyebrow"><span></span> CR2 / INDEPENDENT MEDIA</p>
            <h1 id="intro-title">Crypto.<br />Finance.<br /><span>Tech.</span></h1>
            <p class="intro-dek">Home of <strong>Chill with R2</strong>.<br />Live conversations on Robinhood Chain.</p>
            <a class="watch" href={featured.url} target="_blank" rel="noopener noreferrer"><span class="watch-icon" aria-hidden="true">↗</span><span>Watch the latest<span class="watch-meta">EPISODE {featured.number}</span></span></a>
          </div>
          <div class="sign-stage" id="show">
            <div class="sign-mount" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="sign" id="sign">
              <img class="sign-halo halo-wide" src="/assets/studio-sign.svg" alt="" aria-hidden="true" width="820" height="620" />
              <img class="sign-halo halo-tight" src="/assets/studio-sign.svg" alt="" aria-hidden="true" width="820" height="620" />
              <img class="sign-core" src="/assets/studio-sign.svg" alt="Chill with R2" width="820" height="620" fetchpriority="high" />
            </div>
            <span class="sign-caption" aria-hidden="true"><i></i> THE CR2 STUDIO <span>01 / R2</span></span>
          </div>
        </div>
        <div class="console wrap">
          <div class="schedule"><span class="micro">THE FLAGSHIP SHOW</span><span>Tue + Thu <b>15:00 UTC</b><span class="on-x">Live on X</span></span></div>
          <div class="audio-console"><button id="intro-audio" type="button" aria-pressed="false"><span class="audio-icon" aria-hidden="true">▶</span><span>Play intro</span></button><div class="meter" aria-hidden="true">{Array.from({length:20},(_,i)=><i style={'--bar:' + (16 + ((i * 17) % 31)) + '%'}></i>)}</div><span class="audio-time" aria-hidden="true">0:08</span></div>
          <button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="true" hidden><span class="motion-icon" aria-hidden="true">✳</span><span>Motion on</span></button>
        </div>
        <div class="nojs-audio"><span>Show intro</span><audio controls preload="none" src="/assets/cr2-bumper.wav"></audio></div>
        <audio id="bumper" src="/assets/cr2-bumper.wav" preload="none"></audio>
      </section>
      <section class="archive" id="episodes" aria-labelledby="episodes-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">THE PROGRAM</p><h2 id="episodes-title">Latest broadcasts<span>.</span></h2></div><a class="text-link" href="https://x.com/chillwithr2" target="_blank" rel="noopener noreferrer">All episodes <span aria-hidden="true">↗</span></a></div>
          <div class="episodes">
            {episodes.map((episode,index) => (
              <a class={'episode ' + episode.accent} href={episode.url} target="_blank" rel="noopener noreferrer">
                <div class="episode-art" aria-hidden="true"><div class="art-grid"></div><span class="art-label">CHILL WITH R2</span><span class="art-code">{index===0?'LATEST REPLAY':'FROM THE ARCHIVE'}</span><span class="art-number">{episode.number}</span><div class="art-lines">{Array.from({length:17},(_,i)=><i style={'--i:'+i}></i>)}</div><span class="art-play">↗</span></div>
                <div class="episode-info"><span class="episode-meta">EP {episode.number}<time datetime={episode.dateTime}>{episode.date}</time></span><h3>{episode.title}</h3><p>{episode.guests}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="hosts wrap" id="hosts" aria-labelledby="hosts-title">
        <div><p class="eyebrow">BEHIND THE MICS</p><h2 id="hosts-title">Your hosts<span>.</span></h2></div>
        <div class="host-list">{hosts.map((host)=>(<a class="host" href={host.url} target="_blank" rel="noopener noreferrer"><span class="host-initial" aria-hidden="true">{host.initials}</span><span><strong>{host.name}</strong><small>{host.handle}</small></span><span class="host-arrow" aria-hidden="true">↗</span></a>))}</div>
      </section>
    </main>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p>Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh ↗</a><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top">↑</a></footer>
    <script>import '../scripts/site';</script>
  </body>
</html>

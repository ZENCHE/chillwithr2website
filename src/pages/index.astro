---
import { episodes, hosts } from '../data';
import Header from '../components/Header.astro';
import GuestBooking from '../components/GuestBooking.astro';
import Sponsorship from '../components/Sponsorship.astro';
import Seo from '../components/Seo.astro';
import Arrow from '../components/Arrow.astro';
import { homeSchema } from '../lib/seo';
import { SITE_DESCRIPTION, YOUTUBE_SUBSCRIBE } from '../site-config';
import { homeTitle } from '../lib/pages';
import { permanentGuestPortraits } from '../lib/guest-portraits';
import { episodeHref, replayLink } from '../lib/episode-pages';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/episode.css';

const featured = episodes[0];
const featuredReplay = replayLink(featured);
const permanent = await permanentGuestPortraits();
const title = homeTitle;
const description = SITE_DESCRIPTION;
const schema = homeSchema(title,description);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#21172f" />
    <Seo {title} {description} path="/" {schema} markdown="/index.md" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="top"></div>
    <main id="main">
      <section class="hero" aria-labelledby="intro-title" id="studio">
        <div class="scene" aria-hidden="true">
          <div class="wall"></div><div class="wall-shade"></div>
          <div class="light light-violet"></div><div class="light light-green"></div><div class="light light-pink"></div>
          <div class="scene-grain"></div>
        </div>
        <Header />
        <div class="hero-content wrap">
          <div class="intro-copy">
            <p class="eyebrow"><span></span> CR2 / INDEPENDENT MEDIA</p>
            <h1 id="intro-title">Crypto.<br />Finance.<br /><span>Tech.</span></h1>
            <h2 class="intro-dek">Home of <strong>Chill with R2</strong>, the live crypto show on X.<br />Robinhood Chain, Agentic AI, tokenized stocks and macro, from TradFi to crypto.</h2>
            <div class="hero-actions">
              <a class="watch" href={featuredReplay.url} target="_blank" rel="noopener noreferrer"><Arrow class="watch-icon" /><span>Watch the latest<span class="watch-meta">EPISODE {featured.number}</span></span></a>
              <a class="text-link" href={YOUTUBE_SUBSCRIBE} target="_blank" rel="noopener noreferrer">Subscribe on YouTube <Arrow /></a>
            </div>
          </div>
          <div class="sign-stage" id="show">
            <div class="sign-mount" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="sign" id="sign">
              <img class="sign-halo halo-wide" src="/assets/studio-sign.svg" alt="" aria-hidden="true" width="820" height="620" />
              <img class="sign-halo halo-tight" src="/assets/studio-sign.svg" alt="" aria-hidden="true" width="820" height="620" />
              <img class="sign-core" src="/assets/studio-sign.svg" alt="Chill with R2 neon logo in violet, green and pink" width="820" height="620" fetchpriority="high" />
            </div>
          </div>
        </div>
      </section>
      <section class="hosts wrap" id="hosts" aria-labelledby="hosts-title">
        <div><p class="eyebrow">BEHIND THE MICS</p><h2 id="hosts-title">Your hosts<span>.</span></h2></div>
        <div class="host-list">{hosts.map((host)=>(<a class="host" href={host.url} target="_blank" rel="noopener noreferrer"><img class="host-avatar" src={host.avatar} width="400" height="400" loading="lazy" decoding="async" alt={host.avatarAlt} /><span><strong>{host.name}</strong><small>{host.handle}</small><span class="host-bio">{host.bio}</span></span><Arrow class="host-arrow" /></a>))}</div>
      </section>
      <section class="hosts permanent-guests wrap" id="permanent-guests" aria-labelledby="permanent-title">
        <div><p class="eyebrow">EVERY WEEK ON CR2</p><h2 id="permanent-title">Permanent guests<span>.</span></h2></div>
        <div class="host-list">{permanent.map((guest)=>(<a class="host" href={'https://x.com/' + guest.handle} target="_blank" rel="noopener noreferrer"><img class="host-avatar" src={guest.portrait.src} width="128" height="128" loading="lazy" decoding="async" alt={guest.name + '’s X profile avatar'} /><span><strong>{guest.name}</strong><small>@{guest.handle}</small><span class="host-bio">{guest.role}</span><span class="guest-slot">{guest.slot}</span><span class="host-bio guest-topics">{guest.topics}</span></span><Arrow class="host-arrow" /></a>))}</div>
      </section>
      <section class="archive" id="episodes" aria-labelledby="episodes-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">THE PROGRAM</p><h2 id="episodes-title">Latest broadcasts<span>.</span></h2></div><a class="text-link" href="/episodes/">All episodes <Arrow /></a></div>
          <div class="episodes">
            {episodes.slice(0, 3).map((episode,index) => { const href = episodeHref(episode); const replay = replayLink(episode); return (
              <div class="episode-cell"><a class={'episode ' + episode.accent} href={href ?? episode.url} {...(href ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
                <div class="episode-art" aria-hidden="true"><div class="art-grid"></div><span class="art-label">CHILL WITH R2</span><span class="art-code">{index===0?'LATEST REPLAY':'FROM THE ARCHIVE'}</span><span class="art-number">{episode.number}</span><div class="art-lines">{Array.from({length:17},(_,i)=><i style={'--i:'+i}></i>)}</div><span class="art-play"><Arrow direction={href ? 'east' : 'ne'} /></span></div>
                <div class="episode-info"><span class="episode-meta">EP {episode.number}<time datetime={episode.dateTime}>{episode.date}</time></span><h3>{episode.title}</h3><p>{episode.guests}</p></div>
              </a>{href && <a class="episode-replay" href={replay.url} target="_blank" rel="noopener noreferrer">{replay.label} <Arrow /></a>}</div>
            ); })}
          </div>
          <div class="program-list">
            <h3 id="program-title" class="program-title">Every episode<span>.</span></h3>
            <ol aria-labelledby="program-title">
              {episodes.map((episode) => { const href = episodeHref(episode); const replay = replayLink(episode); return (
                <li class={'program-row ' + episode.accent}>
                  <a href={href ?? episode.url} {...(href ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
                    <span class="program-num">EP {episode.number}</span>
                    <time datetime={episode.dateTime}>{episode.date}</time>
                    <span class="program-name">{episode.title}</span>
                    <span class="program-guests">{episode.guests}</span>
                    <Arrow class="program-arrow" direction={href ? 'east' : 'ne'} />
                  </a>
                  {href && <a class="program-replay" href={replay.url} target="_blank" rel="noopener noreferrer">{replay.label} <Arrow /></a>}
                </li>
              ); })}
            </ol>
          </div>
        </div>
      </section>
      <GuestBooking />
      <Sponsorship />
    </main>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p><a href={YOUTUBE_SUBSCRIBE} target="_blank" rel="noopener noreferrer">Subscribe on YouTube <Arrow /></a><span class="footer-powered">Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh <Arrow /></a></span><small>CR2 is not affiliated with Robinhood Markets, Inc.</small></p><a class="back-top" href="#top" aria-label="Back to top"><Arrow direction="north" /></a></footer>
    <script>import '../scripts/site';</script>
  </body>
</html>

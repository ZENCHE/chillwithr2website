---
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { notFoundSchema } from '../lib/seo';
import { episodes } from '../data';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/about.css';
import '../styles/about-us.css';
const latest = episodes[0];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15101d" />
    <Seo title="Page not found | CR2" description="This page does not exist. Find every Chill with R2 episode, the hosts and the Sponsors page on the CR2 homepage." path="/404.html" schema={notFoundSchema()} noindex />
  </head>
  <body class="about-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="about-opening">
      <Header active="none" />
      <main id="main">
        <section class="notfound wrap" aria-labelledby="nf-title">
          <div class="about-copy">
            <p class="eyebrow">ERROR 404 <span class="about-divider">/</span> OFF AIR</p>
            <h1 id="nf-title">This page is<br /><em>off air.</em></h1>
            <p class="about-dek">The link may be old or mistyped. The show is still live every Tuesday and Thursday at 15:00 UTC on X.</p>
            <div class="sponsor-hero-actions">
              <a class="about-primary" href="/">Back to CR2 <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={latest.url} target="_blank" rel="noopener noreferrer">Watch Episode {latest.number} <span aria-hidden="true">↗</span></a>
            </div>
            <p class="notfound-links"><a class="text-link" href="/#episodes">Every episode</a><a class="text-link" href="/about/">About</a><a class="text-link" href="/sponsors/">Sponsors</a></p>
          </div>
        </section>
      </main>
    </div>
    <footer class="footer wrap"><div class="footer-brand">CR2<span>© 2026</span></div><p>Powered by <a href="https://x.com/Moshdottrade" target="_blank" rel="noopener noreferrer">Mosh ↗</a><small>CR2 is not affiliated with Robinhood Markets, Inc. <a href="/about/#disclosures">Disclosures</a></small></p><a class="back-top" href="#main" aria-label="Back to top">↑</a></footer>
  </body>
</html>

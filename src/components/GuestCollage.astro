---
import Arrow from './Arrow.astro';
import { guestPortraits } from '../lib/guest-portraits';
import '../styles/guest-collage.css';
const portraits = await guestPortraits();
const angles = [-8, 4, -3, 8, 5, -6, 7, -4, -5, 6, -7, 4];
const offsets = [5, -2, 7, 0, -1, 5, -3, 4, 3, -4, 4, -2];
const bios: Record<string, string> = {};
---
<figure class="guest-collage" data-guest-collage aria-label="CR2 guests">
  <ul class="collage-grid">
    {portraits.map((guest, index) => (
      <li class="collage-guest" style={`--tilt:${angles[index % angles.length]}deg;--lift:${offsets[index % offsets.length]}px`}>
        <button class="collage-avatar" type="button" aria-label={`About ${guest.name}`} aria-expanded="false" aria-controls={`guest-bio-${guest.handle}`} aria-describedby={`guest-bio-${guest.handle}`}>
          <img src={guest.portrait.src} width="256" height="256" loading="lazy" decoding="async" alt={`${guest.name} (@${guest.handle}), ${guest.role.replace(/[¹²]/g, '')}`} />
        </button>
        <div class="collage-bio" id={`guest-bio-${guest.handle}`} role="tooltip" hidden>
          <strong>{guest.name}</strong>
          <span class="collage-handle">@{guest.handle}</span>
          <p>{bios[guest.handle] ?? guest.role.replace(/[¹²]/g, '')}</p>
        </div>
      </li>
    ))}
  </ul>
  <noscript><p class="collage-fallback"><a href="/partners/#guests">Meet the guests <Arrow direction="east" /></a></p></noscript>
</figure>
<script>
  import '../scripts/guest-collage';
</script>

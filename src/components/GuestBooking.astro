---
import ContactForm from './ContactForm.astro';
import GuestCollage from './GuestCollage.astro';
import { bookingEndpoint } from '../site-config';
import '../styles/booking.css';
const ready = Boolean(bookingEndpoint);
---
<section class="booking-row wrap" id="guest-spot" aria-labelledby="booking-row-title">
  <div class="booking-row-copy">
    <p class="eyebrow">COME ON THE SHOW</p>
    <h2 id="booking-row-title">Book a guest spot<span>.</span></h2>
    <p class="booking-dek">Tell us what you’re building in crypto, finance or tech.</p>
    <a class="booking-trigger" href="#guest-booking-info" aria-haspopup="dialog" aria-controls="guest-dialog" data-booking-open data-dialog-target="guest-dialog">Pitch your story <span aria-hidden="true">↗</span></a>
  </div>
  <GuestCollage />
</section>
<dialog class="guest-dialog" id="guest-dialog" data-contact-dialog aria-labelledby="guest-title" aria-describedby="guest-intro">
  <div class="guest-dialog-inner">
    <button class="guest-close" type="button" aria-label="Close guest booking" data-contact-close>×</button>
    <p class="eyebrow">CHILL WITH R2 / GUEST REQUEST</p>
    <h2 id="guest-title" tabindex="-1" data-dialog-heading>Let’s talk<span>.</span></h2>
    <p id="guest-intro">Introduce yourself and the conversation you’d like to have.</p>
    <ContactForm kind="guest" id="guest" />
  </div>
</dialog>
<noscript><div class="wrap booking-no-script" id="guest-booking-info"><p>Guest booking {ready ? 'requires JavaScript to send your request.' : 'opens soon.'} <a href="https://x.com/chillwithr2">Follow CR2 on X.</a></p></div></noscript>

